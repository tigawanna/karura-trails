{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "APP_VARIANT=development expo start",
    "dev:reset-db": "EXPO_PUBLIC_RESET_DATABASE=1 APP_VARIANT=development expo start --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "fetch:spatialite": "node ./scripts/fetch-spatialite-libs.js",
    "eas-build-pre-install": "node ./scripts/fetch-spatialite-libs.js",
    "android": "expo run:android",
    "run:android": "pnpm fetch:spatialite && expo run:android",
    "ios": "expo run:ios",
    "run:ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "pnpm fetch:spatialite && expo prebuild --clean",
    "prebuild:android": "pnpm fetch:spatialite && expo prebuild -p android --clean",
    "prebuild:ios": "pnpm fetch:spatialite && expo prebuild -p ios --clean",
    "build-dev:local": "EXPO_DEBUG=1 eas build --platform android --profile development --local --verbose-logs --build-logger-level=debug",
    "build-preview:local": "EXPO_DEBUG=1 eas build --platform android --profile preview:local --local --verbose-logs --build-logger-level=debug",
    "build-preview:eas": "EXPO_DEBUG=1 eas build --platform android --profile preview:eas --verbose-logs --build-logger-level=debug",
    "build-production": "EXPO_DEBUG=1 eas build --platform android --profile production --verbose-logs --build-logger-level=debug",
    "lint": "expo lint",
    "check-types": "tsgo --noEmit",
    "db:migrate": "npx drizzle-kit generate"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.14",
    "@expo/ui": "~56.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@maplibre/maplibre-react-native": "^11.3.0",
    "@op-engineering/op-sqlite": "^16.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.100.13",
    "babel-preset-expo": "~56.0.0",
    "deepmerge": "^4.3.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-query-logger": "^1.1.2",
    "expo": "~56.0.9",
    "expo-asset": "^56.0.16",
    "expo-build-properties": "^56.0.17",
    "expo-constants": "~56.0.17",
    "expo-dev-client": "^56.0.19",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.5",
    "expo-glass-effect": "~56.0.4",
    "expo-image": "~56.0.10",
    "expo-image-picker": "~56.0.16",
    "expo-linking": "~56.0.13",
    "expo-location": "^56.0.16",
    "expo-network": "^56.0.5",
    "expo-router": "~56.2.9",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-drawer-layout": "^4.2.4",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.15",
    "@typescript/native-preview": "7.0.0-dev.20260519.1",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint-config-expo": "~56.0.4",
    "typescript": "6.0.3"
  }
}
