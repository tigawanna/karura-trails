{
  "name": "karura-trails",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev dev:pglite-proxy --filter=web",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix .",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "check-types": "turbo run check-types",
    "quality": "turbo run //#lint //#format",
    "quality:fix": "turbo run //#lint:fix //#format:fix",
    "prepare": "vp config",
    "db:studio": "pnpm --filter web db:studio",
    "db:studio:d1": "pnpm --filter web db:studio:d1",
    "db:studio:pglite": "pnpm --filter web db:studio:pglite",
    "db:pglite:proxy": "pnpm --filter web db:pglite:proxy",
    "sync:icons": "tsx ./scripts/generate-expo-icons.ts && tsx ./scripts/sync-expo-icons.ts",
    "generate:icons": "tsx ./scripts/generate-expo-icons.ts"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260519.1",
    "sharp": "^0.34.5",
    "tsx": "^4.22.4",
    "turbo": "^2.9.16",
    "typescript": "6.0.3",
    "vite-plus": "latest"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "esbuild": "0.25.12",
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@^0.1.20"
    },
    "peerDependencyRules": {
      "allowAny": [
        "vite",
        "vitest"
      ],
      "allowedVersions": {
        "vite": "*",
        "vitest": "*"
      }
    }
  }
}
